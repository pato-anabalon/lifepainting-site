# Canonical origin: leave unset (also in Vercel). The site uses the project's primary production domain
# (VERCEL_PROJECT_PRODUCTION_URL), so it switches to lifepaintingdec.co.nz by itself. Override only if needed:
# NEXT_PUBLIC_SITE_URL=https://lifepaintingdec.co.nz

# Lead delivery. Empty in development = explicit simulation mode. Empty in production = routes answer 503 (never a fake success).
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@lifepaintingdec.co.nz
CONTACT_FROM_EMAIL=
# Photo uploads: a Blob store connected in Vercel sets BLOB_STORE_ID (OIDC); older stores use BLOB_READ_WRITE_TOKEN. Either one is enough.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Production: the three email vars and one Blob credential must be set in Vercel, or the form answers "unavailable" (call/email fallback).
